# Single public entry point: the site, every demo subdomain and BotFactory.
# deploy/deploy.sh validates this file, installs it and switches the release symlink.
{
	email darian.mirelli@gmail.com
}

(security) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
}

# Cache rules. Caddy runs several `header` lines in order of matcher specificity, so the catch-all uses `?`
# (set only if nothing more specific already did).
(static) {
	import security
	@hashed path /_next/static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@media path *.jpg *.jpeg *.png *.svg *.webp *.woff2 *.ico
	header @media Cache-Control "public, max-age=600"
	header ?Cache-Control "no-cache"
}

(demo) {
	import static
	root * /var/www/mirelli/current/demos/{args[0]}
	header Content-Security-Policy "frame-ancestors 'self' https://mirelli.eu https://dimkaprojects.xyz"
	header X-Robots-Tag "noindex, follow"
	file_server
}

mirelli.eu {
	import static
	root * /var/www/mirelli/current/site
	handle /coffee* {
		header Content-Type "text/plain; charset=utf-8"
		respond <<TEXT
			418 I'm a teapot.

			This server refuses to brew coffee because it is, permanently, a teapot.
			Try tea. It does not exist either.

			(RFC 2324, section 2.3.2)
			TEXT 418
	}
	handle /api/contact* {
		reverse_proxy 127.0.0.1:8787
	}
	handle {
		file_server
	}
	handle_errors {
		@missing expression {err.status_code} == 404
		handle @missing {
			rewrite * /not-found.html
			file_server {
				status 404
			}
		}
	}
}

www.mirelli.eu {
	import security
	redir https://mirelli.eu{uri} permanent
}

# Old domain: everything moves to mirelli.eu with a permanent redirect. The contact endpoint stays reachable
# so a page cached before the move can still submit its form.
dimkaprojects.xyz, www.dimkaprojects.xyz {
	import security
	handle /api/contact* {
		reverse_proxy 127.0.0.1:8787
	}
	handle {
		redir https://mirelli.eu{uri} permanent
	}
}

