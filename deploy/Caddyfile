# Single public entry point for the VPS: serves the site, every demo subdomain and BotFactory.
# Install: sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
{
	email darian.mirelli@gmail.com
}

(common) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
	header Cache-Control "no-cache"
	@hashed path /_next/static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@media path *.jpg *.jpeg *.png *.svg *.webp *.woff2
	header @media Cache-Control "public, max-age=600"
}

(demo) {
	import common
	root * /opt/docker/showroom/demos/{args[0]}
	header Content-Security-Policy "frame-ancestors 'self' https://dimkaprojects.xyz"
	file_server
}

dimkaprojects.xyz {
	import common
	handle /coffee* {
		header Content-Type "text/plain; charset=utf-8"
		respond <<TEXT
			418 I'm a teapot.

			This server refuses to brew coffee because it is, permanently, a teapot.
			Try tea. It does not exist either.

			(RFC 2324, section 2.3.2)
			TEXT 418
	}
	root * /opt/docker/showroom/out
	file_server
	@missing expression {err.status_code} == 404
	handle_errors @missing {
		rewrite * /not-found.html
		file_server {
			status 404
		}
	}
}

www.dimkaprojects.xyz {
	redir https://dimkaprojects.xyz{uri} permanent
}

dizeltrade.dimkaprojects.xyz {
	import demo dizeltrade
}
